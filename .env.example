# Copy to .env for local development.  Never commit real keys.
# Secrets may also be referenced from config as "env:OPENAI_API_KEY" or "keyring:unknown-agent/openai".
UNKNOWN_AGENT_PROVIDER=openai-compatible
UNKNOWN_AGENT_MODEL=gpt-4.1-mini
UNKNOWN_AGENT_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
UNKNOWN_AGENT_LOG_LEVEL=info
UNKNOWN_AGENT_TELEMETRY_ENABLED=false
