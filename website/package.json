    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "6.0.8",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "vitest": "3.2.7"
  }
}
